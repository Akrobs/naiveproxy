#!/usr/bin/env bash
set -euo pipefail

CONF="/etc/unbound/unbound.conf.d/yurich-dns.conf"
LEGACY_CONF="/etc/unbound/unbound.conf.d/aurum-vpn.conf"
ENV_FILE="/etc/yurich-dns/yurich-dns.env"
LEGACY_ENV_FILE="/etc/aurum-dns/aurum-dns.env"

is_ipv4() {
    local ip="$1" part
    local -a parts
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS='.' read -r -a parts <<< "$ip"
    for part in "${parts[@]}"; do
        [[ "$part" =~ ^[0-9]{1,3}$ ]] || return 1
        [[ "$part" == "0" || "$part" != 0* ]] || return 1
        (( 10#$part <= 255 )) || return 1
    done
}

is_ipv4_cidr() {
    local cidr="$1" ip prefix
    [[ "$cidr" == */* ]] || return 1
    ip="${cidr%/*}"
    prefix="${cidr##*/}"
    is_ipv4 "$ip" || return 1
    [[ "$prefix" =~ ^(0|[1-9]|[12][0-9]|3[0-2])$ ]]
}

is_valid_cidr_list() {
    local value="$1" cidr
    local -a cidr_items
    IFS=',' read -r -a cidr_items <<< "$value"
    (( ${#cidr_items[@]} >= 1 && ${#cidr_items[@]} <= 32 )) || return 1
    for cidr in "${cidr_items[@]}"; do
        is_ipv4_cidr "$cidr" || return 1
    done
}

root_controlled_env_file() {
    local env_file="$1" candidate owner_uid mode
    [[ -f "$env_file" && ! -L "$env_file" ]] || return 1
    for candidate in "$env_file" "$(dirname "$env_file")"; do
        owner_uid=$(stat -c '%u' "$candidate" 2>/dev/null || echo -1)
        mode=$(stat -c '%a' "$candidate" 2>/dev/null || echo invalid)
        [[ "$owner_uid" == "0" && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
        (( (8#$mode & 022) == 0 )) || return 1
    done
}

parse_dns_env_value() {
    local raw="$1"
    if [[ "$raw" == \'*\' && ${#raw} -ge 2 ]]; then raw="${raw:1:${#raw}-2}"
    elif [[ "$raw" == \"*\" && ${#raw} -ge 2 ]]; then raw="${raw:1:${#raw}-2}"
    elif [[ "$raw" == *\'* || "$raw" == *\"* ]]; then return 1
    fi
    printf '%s\n' "$raw"
}

load_env_if_safe() {
    local env_file="$ENV_FILE"
    [[ -f "$env_file" ]] || env_file="$LEGACY_ENV_FILE"
    [[ -f "$env_file" ]] || return 0
    root_controlled_env_file "$env_file" || { echo "Skip unsafe DNS env file: $env_file" >&2; return 0; }
    local line key raw value gateway="" cidr_value="" seen_gateway=0 seen_cidrs=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        [[ "$line" =~ ^(YURICH_DNS_GATEWAY|YURICH_DNS_CIDRS)=(.*)$ ]] || { echo "Skip invalid DNS env syntax: $env_file" >&2; return 0; }
        key="${BASH_REMATCH[1]}"; raw="${BASH_REMATCH[2]}"
        value=$(parse_dns_env_value "$raw") || { echo "Skip unsafe DNS env value: $key" >&2; return 0; }
        case "$key" in
            YURICH_DNS_GATEWAY)
                (( seen_gateway == 0 )) || return 0
                [[ -z "$value" ]] || is_ipv4 "$value" || return 0
                gateway="$value"; seen_gateway=1
                ;;
            YURICH_DNS_CIDRS)
                (( seen_cidrs == 0 )) || return 0
                is_valid_cidr_list "$value" || return 0
                cidr_value="$value"; seen_cidrs=1
                ;;
        esac
    done < "$env_file"
    (( seen_gateway == 0 )) || YURICH_DNS_GATEWAY="$gateway"
    (( seen_cidrs == 0 )) || YURICH_DNS_CIDRS="$cidr_value"
}

load_env_if_safe

echo "===== DNS (Unbound) status ====="
systemctl status unbound --no-pager || true
echo
echo "===== Port 53 listeners ====="
ss -H -lntup 2>/dev/null | awk '$5 ~ /:53$/ || $5 ~ /:53%/ {print}' || true
echo
echo "===== Config check ====="
if [[ -f "$CONF" ]]; then
    unbound-checkconf || true
elif [[ -f "$LEGACY_CONF" ]]; then
    unbound-checkconf || true
else
    echo "Config not found: $CONF"
fi
echo
echo "===== Config summary ====="
echo "Gateway: ${YURICH_DNS_GATEWAY:-127.0.0.1}"
echo "CIDRs:   ${YURICH_DNS_CIDRS:-unknown}"
echo
echo "===== Last logs ====="
journalctl -u unbound -n 40 --no-pager || true
